{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanAI-Impact-Bench v0.8 automated study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_version",
    "study_id",
    "dataset_root",
    "selection_path",
    "fixtures_path",
    "system_prompt_path",
    "targets",
    "judges",
    "generation_replicates",
    "rating_replicates",
    "retry_attempts",
    "budget",
    "analysis_seed",
    "bootstrap_resamples"
  ],
  "properties": {
    "study_version": {
      "const": "0.8"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "dataset_root": {
      "type": "string",
      "minLength": 1
    },
    "selection_path": {
      "type": "string",
      "minLength": 1
    },
    "fixtures_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "system_prompt_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "judges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/judge"
      }
    },
    "generation_replicates": {
      "type": "integer",
      "minimum": 1
    },
    "rating_replicates": {
      "type": "integer",
      "minimum": 1
    },
    "retry_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_requests",
        "max_output_tokens"
      ],
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "analysis_seed": {
      "type": "integer"
    },
    "bootstrap_resamples": {
      "type": "integer",
      "minimum": 2
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "base_url",
        "model",
        "max_tokens",
        "temperature",
        "api_key_env",
        "candidate_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "api_key_env": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64}|git:[a-f0-9]{40})$"
        },
        "api_protocol": {
          "type": "string",
          "enum": ["chat_completions", "responses", "anthropic_messages"],
          "default": "chat_completions"
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 60
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["api_protocol"],
            "properties": {"api_protocol": {"const": "anthropic_messages"}}
          },
          "then": {
            "required": ["use_response_format"],
            "properties": {"use_response_format": {"const": false}}
          }
        }
      ],
      "required": [
        "id",
        "family",
        "base_url",
        "model",
        "max_tokens",
        "temperature",
        "api_key_env"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "api_key_env": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "api_protocol": {
          "type": "string",
          "enum": ["chat_completions", "responses", "anthropic_messages"],
          "default": "chat_completions"
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 60
        },
        "use_response_format": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
